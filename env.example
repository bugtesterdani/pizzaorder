# Kopieren nach .env und Werte anpassen:   cp env.example .env
# Die .env wird von git ignoriert – niemals committen.

# Admin-Passwort für /admin. Unbedingt ein neues, langes Passwort wählen!
ADMIN_PASSWORD=bitte-aendern

# Geheimer Schlüssel zum Signieren der Admin-Logins (JWT).
# Erzeugen z. B. mit:  openssl rand -hex 32
JWT_SECRET=bitte-mit-openssl-rand-hex-32-erzeugen

# Adresse, unter der die Seite im Browser aufgerufen wird (für CORS),
# z. B. http://192.168.1.50:8080 oder https://pizza.example.de
CORS_ORIGINS=http://localhost:8080

# Port auf der VM. Nur aus der VM selbst erreichbar machen (z. B. hinter Caddy):
#   HTTP_PORT=127.0.0.1:8080
HTTP_PORT=8080

# Name der Datenbank in MongoDB
DB_NAME=pizzaorder

# Titel im Browser-Tab
APP_TITLE=MittwochsPizza

# Arbeitsspeicher-Cache von MongoDB in GB. 0.25 reicht für die Bestellseite
# locker; der ganze Container ist auf 1 GB RAM begrenzt.
MONGO_CACHE_GB=0.25

# Nur für HTTPS über Caddy (docker compose --profile https up -d):
# DOMAIN=pizza.example.de
